# ============================================================================
# env.yaml - Configuración de aplicación para entorno: silicon
# ============================================================================
# Clon local del entorno pre sobre VMs Oracle Linux 10 arm64 (UTM / Apple Silicon).
#   - Dominio interno anewhope.silicon.loc (bind + /etc/hosts)
#   - frontend y backend 100% en Docker (docker-compose)
#   - Persistencia /data/<server>/<app>/ (logs anidados)
#   - Sin SSL público (Nginx interno HTTP)
#   - trainer sin GPU: Ollama por CPU; training_mode en simulación
# ============================================================================

# Modo de almacenamiento de datos
storage_mode: db_only

# Sincronización DB → JSON
active_sync_db_jsons: "1"
sync_database_interval_seconds: "300"

# ============================================================================
# Domain configuration (silicon - VMs locales)
# ============================================================================
public_name: anewhope.silicon.loc
laim_public_name: laim.anewhope.silicon.loc
private_name: anewhope.silicon.loc

# ============================================================================
# Applications in servers (silicon)
# ============================================================================
# Backend Core (3_backend) - servidor backend - 8003
backend_core_host: backend.anewhope.silicon.loc
backend_core_port: "8003"

# Backend IA / Trainer (4_trainer) - servidor trainer - 8004
trainer_host: trainer.anewhope.silicon.loc
trainer_port: "8004"

# Web Frontend (5_web_frontend) - servidor frontend - 8005
frontend_host: frontend.anewhope.silicon.loc
frontend_port: "8005"

# Web Backoffice (6_web_backoffice) - servidor frontend - 8006
backoffice_host: frontend.anewhope.silicon.loc
backoffice_port: "8006"

# LAIM Web (9_laimweb) - servidor frontend - 8010
laimweb_host: frontend.anewhope.silicon.loc
laimweb_port: "8010"

# Middleware (7_service_frontend) - servidor frontend - 8007
middleware_host: frontend.anewhope.silicon.loc
middleware_port: "8007"

# Broker (8_service_backend) - servidor backend - 8008
broker_host: backend.anewhope.silicon.loc
broker_port: "8008"

# Fmanagement (API Go de ficheros) - servidor backend - 1666
fmanagement_host: backend.anewhope.silicon.loc
fmanagement_port: "1666"

# ============================================================================
# URLs públicas de Reflex (api_url compilado en el JS del frontend)
# En silicon el navegador accede vía Nginx HTTP interno.
# ============================================================================
frontend_api_url: http://frontend.anewhope.silicon.loc
backoffice_api_url: http://frontend.anewhope.silicon.loc:8443
laimweb_api_url: http://laim.anewhope.silicon.loc

# ============================================================================
# URLs de servicios internos
# ============================================================================
broker_backend_base_url: http://backend.anewhope.silicon.loc:8008
core_backend_base_url: http://backend.anewhope.silicon.loc:8003
middleware_base_url: http://frontend.anewhope.silicon.loc:8007
fmanagement_base_url: http://backend.anewhope.silicon.loc:1666
fmanagement_base_path: /data/backend/external
trainer_base_url: http://trainer.anewhope.silicon.loc:8004

# ============================================================================
# Redis (sesión compartida frontend/backoffice) - contenerizado en frontend
# ============================================================================
redis_host: frontend.anewhope.silicon.loc
redis_port: "6379"
redis_db: "0"
redis_token_expiration: "28800"
redis_lock_expiration: "10000"
redis_lock_warning_threshold: "1000"

# ============================================================================
# MariaDB (contenerizado en backend)
# ============================================================================
mariadb_host: backend.anewhope.silicon.loc
mariadb_port: "3306"
mariadb_projects_database: myllm_projects_db
laim_core_database: laim_core_db

# ============================================================================
# LAIM Web — Cap CAPTCHA (registro público, auto-hospedado)
# ============================================================================
laim_cap_api_endpoint: "http://laim.anewhope.silicon.loc/cap/dcbb5f3bb8/"

# ============================================================================
# Rutas de almacenamiento para fmanagement (nomenclatura /data/<server>/<app>)
# ============================================================================
backend_core_base_storage: /data/backend/external
backend_core_internal_storage: /data/backend/internal
backend_core_reports_storage: /data/backend/internal/reports
backend_core_models_storage: /data/backend/internal/models
backend_ia_base_storage: /data/trainer/external
backend_ia_internal_storage: /data/trainer/internal
backend_ia_reports_storage: /data/trainer/internal/reports
backend_ia_models_storage: /data/trainer/internal/models

# URL directa al backend core (usada por trainer para notificar jobs)
backend_core_base_url: http://backend.anewhope.silicon.loc:8003

# ============================================================================
# ChromaDB (servidor gestionado por trainer)
# ============================================================================
chroma_host: trainer.anewhope.silicon.loc
chroma_port: "8100"
chroma_persist_directory: /data/trainer/chroma
chroma_collection_name: myllm_embeddings
chroma_anonymized_telemetry: "false"
chroma_log_level: WARNING

# ============================================================================
# Ollama para RAG (modelo ligero para CPU en simulación)
# ============================================================================
ollama_rag_base_model: "deepseek-r1:1.5b"

# ============================================================================
# Modo de ejecución de Reflex (dev/prod)
# ============================================================================
reflex_env_mode: dev

# ============================================================================
# Modo de entrenamiento (switch simulación/producción)
# En silicon: simulación (mismo flujo, sin GPU/CUDA).
# NOTA: 'training_mode' no aparece consumido en el código de ../anewhope;
#       se mantiene por paridad con pre. Confirmar semántica del switch.
# ============================================================================
training_mode: simulation

# ============================================================================
# Configuración de transferencia de versiones (rsync remoto)
# ============================================================================
transfer_mode: remote
trainer_ssh_host: trainer.anewhope.silicon.loc
trainer_ssh_user: rsync_user
trainer_ssh_key_path: /opt/anewhope/keys/rsync_key
trainer_ssh_port: "22"

# ============================================================================
# Proxy de internet (Squid en util01 silicon)
# ============================================================================
proxy_url: "http://util01.anewhope.silicon.loc:3128"
proxy_no_proxy: "localhost,127.0.0.1,192.168.64.0/24,.anewhope.silicon.loc"

# ============================================================================
# LAIM Web — Foro
# ============================================================================
laim_forum_active: "true"
laim_forum_api_host: "0.0.0.0"
laim_forum_api_port: "8766"
laim_forum_api_base_url: "http://backend.anewhope.silicon.loc:8766"
laim_forum_poll_interval_seconds: "3"
laim_forum_storage_path: /data/backend/laim/forum
laim_site_storage_path: /data/backend/laim/site
laim_forum_max_strikes_url: "3"
laim_forum_max_attachments_per_message: "3"
laim_forum_max_image_bytes: "5242880"
