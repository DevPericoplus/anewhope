worker_processes  1;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;

    server {
        listen 80;
        server_name {{ nginx_server_name }};

        location / {
            proxy_pass http://{{ web_frontend_host }}:{{ web_frontend_port }};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        location /backoffice/ {
            proxy_pass http://{{ web_backoffice_host }}:{{ web_backoffice_port }};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
    }
}
