# Configuración de entorno para servidor Frontend
# Copiar este archivo a .env y ajustar valores según el entorno

# ====================
# ENTORNO
# ====================
# Valores: dev, pre, pro
ENVIRONMENT=dev

# ====================
# REDIS - Recursos
# ====================
# Límites de CPU (número de cores)
REDIS_CPU_LIMIT=2.0
REDIS_CPU_RESERVATION=1.0

# Límites de memoria (usar sufijos: m, g)
# dev: 512m-1g, pre: 2g-4g, pro: 8g-12g
REDIS_MEMORY_LIMIT=2g
REDIS_MEMORY_RESERVATION=1g

# ====================
# SERVICE FRONTEND - Sincronización
# ====================
# Activar sincronización DB/JSON (0=no, 1=sí)
ACTIVE_SYNC_DB_JSONS=0

# Intervalo de sincronización en segundos
SYNC_DATABASE_INTERVAL_SECONDS=300

# ====================
# BROKER BACKEND
# ====================
# URL del backend broker
BROKER_BACKEND_BASE_URL=http://backend-broker:8008

# ====================
# NOTAS POR ENTORNO
# ====================
# 
# DEV:
#   ENVIRONMENT=dev
#   REDIS_MEMORY_LIMIT=512m
#   REDIS_CPU_LIMIT=1.0
#
# PRE:
#   ENVIRONMENT=pre
#   REDIS_MEMORY_LIMIT=2g
#   REDIS_CPU_LIMIT=2.0
#
# PRO:
#   ENVIRONMENT=pro
#   REDIS_MEMORY_LIMIT=8g
#   REDIS_CPU_LIMIT=4.0
#   ACTIVE_SYNC_DB_JSONS=0  # Recomendado: 0 en producción
