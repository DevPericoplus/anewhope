# ====================
# Variables de entorno para desarrollo local (macbook)
# ====================
# Copiar a .env para usar con docker-compose

# Entorno de despliegue
ENVIRONMENT=macbook

# Modo de almacenamiento
STORAGE_MODE=db_only

# ====================
# Redis (sesión compartida)
# ====================
REDIS_PASSWORD=

# ====================
# URLs de servicios (dentro de docker-compose)
# ====================
# Estos valores usan los nombres de servicio de docker-compose
MIDDLEWARE_BASE_URL=http://service_frontend:8007
BROKER_BACKEND_BASE_URL=http://service_backend:8008
CORE_BACKEND_BASE_URL=http://backend_core:8003

# Trainer (nativo en macbook, no dockerizado)
TRAINER_BACKEND_BASE_URL=http://host.docker.internal:8004

# Fmanagement (nativo en macbook)
FMANAGEMENT_BASE_URL=http://host.docker.internal:1666

# ====================
# Sincronización DB/JSON (activa en desarrollo)
# ====================
ACTIVE_SYNC_DB_JSONS=1
SYNC_DATABASE_INTERVAL_SECONDS=60

# ====================
# MariaDB (nativo en macbook, acceso via host.docker.internal)
# ====================
MARIADB_CORE_DATABASE=myllm_core_db
MARIADB_PROJECTS_DATABASE=myllm_projects_db
