# ====================
# Variables de entorno para servidor Trainer
# ====================
# Copiar a .env y ajustar valores según el entorno

# Entorno de despliegue (dev, pre, pro)
ENVIRONMENT=dev

# Modo de almacenamiento
STORAGE_MODE=db_only

# ====================
# Almacenamiento de versiones
# ====================
BACKEND_IA_BASE_STORAGE=/data/files/trainer

# ====================
# URLs de servicios externos
# ====================
# Fmanagement (en servidor backend)
FMANAGEMENT_BASE_URL=http://backend.house.loc:1666

# Ollama (servidor LLM local - comunicación directa según ADR)
OLLAMA_BASE_URL=http://localhost:11434

# ====================
# GPU (para Ollama, si disponible)
# ====================
# Descomentar si hay GPU disponible
# NVIDIA_VISIBLE_DEVICES=all
