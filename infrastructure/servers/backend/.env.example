# ====================
# Variables de entorno para servidor Backend
# ====================
# Copiar a .env y ajustar valores según el entorno

# Entorno de despliegue (dev, pre, pro)
ENVIRONMENT=dev

# Modo de almacenamiento
STORAGE_MODE=db_only

# ====================
# URLs de servicios internos
# ====================
CORE_BACKEND_BASE_URL=http://backend_core:8003
TRAINER_BACKEND_BASE_URL=http://trainer.house.loc:8004
MIDDLEWARE_BASE_URL=http://frontend.house.loc:8007

# ====================
# Fmanagement
# ====================
FMANAGEMENT_BASE_URL=http://fmanagement:1666
BACKEND_CORE_BASE_STORAGE=/data/files/external
BACKEND_IA_BASE_STORAGE=/data/files/trainer

# Transferencia de versiones
TRANSFER_MODE=remote
TRAINER_SSH_HOST=trainer.house.loc
TRAINER_SSH_USER=rsync_user
TRAINER_SSH_KEY_PATH=/opt/anewhope/keys/rsync_key
TRAINER_SSH_PORT=22

# ====================
# MariaDB
# ====================
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_CORE_DATABASE=myllm_core_db
MARIADB_PROJECTS_DATABASE=myllm_projects_db

# Usuarios
MARIADB_ROOT_USER=root
MARIADB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MARIADB_ADMIN_USER=myllm_admin
MARIADB_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
MARIADB_WRITER_USER=myllm_writer
MARIADB_WRITER_PASSWORD=CHANGE_ME_WRITER_PASSWORD
MARIADB_READER_USER=myllm_reader
MARIADB_READER_PASSWORD=CHANGE_ME_READER_PASSWORD

# DSNs (ajustar según entorno)
MARIADB_ADMIN_DSN=mysql+pymysql://myllm_admin:CHANGE_ME@mariadb:3306/myllm_core_db
MARIADB_WRITER_DSN=mysql+pymysql://myllm_writer:CHANGE_ME@mariadb:3306/myllm_core_db
MARIADB_READER_DSN=mysql+pymysql://myllm_reader:CHANGE_ME@mariadb:3306/myllm_core_db
MARIADB_ROOT_DSN=mysql+pymysql://root:CHANGE_ME@mariadb:3306/myllm_core_db
