{# ============================================================================
   Plantilla Jinja2: Informe de Evaluación y Calidad de Modelo LLM
   ---------------------------------------------------------------------------
   Genera un informe completo de evaluación de modelos LLM entrenados,
   incluyendo métricas de calidad, rendimiento y recomendaciones.

   Variables esperadas:

   IDENTIFICACIÓN:
     - nombre_organizacion  : str   - Nombre de la organización
     - nombre_proyecto      : str   - Nombre del proyecto
     - version_name         : str   - Identificador de la versión (ej: v001)
     - ver_folder           : str   - Carpeta de la versión
     - modelo_nombre        : str   - Nombre completo del modelo evaluado
     - base_model           : str   - Modelo base utilizado (ej: llama3.2:latest)

   PARÁMETROS DE ENTRENAMIENTO:
     - training_id          : int   - ID del entrenamiento
     - sequence_number      : int   - Número de secuencia del entrenamiento
     - training_mode        : str   - Modo de entrenamiento (simulation, test, production)
     - fecha_entrenamiento  : str   - Fecha de creación del entrenamiento
     - temperatura          : float - Temperatura de generación (0.0 - 1.0)
     - top_k                : int   - Top-K para sampling
     - top_p                : float - Top-P (nucleus sampling)
     - num_ctx              : int   - Tamaño de ventana de contexto (tokens)
     - num_predict          : int   - Número máximo de tokens a generar
     - chunk_size           : int   - Tamaño de chunks para procesamiento
     - chunk_overlap        : int   - Solapamiento entre chunks
     - embedding_model      : str   - Modelo de embeddings utilizado

   DATOS DEL ENTRENAMIENTO:
     - num_documents        : int   - Número total de documentos procesados
     - num_chunks           : int   - Número total de chunks generados
     - num_archivos_texto   : int   - Número de archivos de texto procesados
     - num_archivos_binarios: int   - Número de archivos binarios
     - total_kb             : float - Tamaño total de datos procesados (KB)
     - document_types       : str   - Tipos de documentos (ej: pdf, txt, py, md)
     - collection_name      : str   - Nombre de la colección ChromaDB

   TIEMPOS DE EJECUCIÓN:
     - duracion_total       : str   - Duración total del entrenamiento (formato HH:MM:SS)
     - tiempo_validacion    : str   - Tiempo de fase de validación
     - tiempo_preparacion   : str   - Tiempo de fase de preparación
     - tiempo_configuracion : str   - Tiempo de fase de configuración
     - tiempo_entrenamiento : str   - Tiempo de fase de entrenamiento

   MÉTRICAS DE EVALUACIÓN (Opcionales - se muestran si están disponibles):
     - humaneval_pass_at_1       : float - HumanEval Pass@1 (0.0-1.0)
     - humaneval_umbral          : float - Umbral objetivo para HumanEval
     - mbpp_pass_at_1            : float - MBPP Pass@1 (0.0-1.0)
     - mbpp_umbral               : float - Umbral objetivo para MBPP
     - bertscore_f1              : float - BERTScore F1 (0.0-1.0)
     - bertscore_umbral          : float - Umbral objetivo para BERTScore
     - rouge_l                   : float - Rouge-L score (0.0-1.0)
     - rouge_l_umbral            : float - Umbral objetivo para Rouge-L
     - tasa_alucinacion          : float - Tasa de alucinación (0.0-1.0)
     - tasa_alucinacion_umbral   : float - Umbral objetivo para alucinación
     - latencia_promedio         : float - Latencia promedio en ms
     - throughput                : float - Throughput en tokens/segundo
     - rechazo_prompts_toxicos   : float - % de rechazo de prompts tóxicos
     - fuga_pii                  : int   - Casos detectados de fuga de PII
     - casos_prueba_ejecutados   : int   - Número de casos de prueba ejecutados

   ANÁLISIS CUALITATIVO (Opcionales):
     - errores_frecuentes        : str   - Descripción de errores frecuentes
     - fortalezas_modelo         : str   - Fortalezas identificadas del modelo
     - recomendaciones           : str   - Recomendaciones específicas

   ============================================================================ #}
